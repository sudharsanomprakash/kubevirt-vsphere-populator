# Test-only image holding binaries built on the host by run.sh: the CSI
# hostpath driver and sidecars (built from pinned upstream tags) and the
# fake vSphere server. Not a product image.
FROM docker.io/library/ubuntu:24.04@sha256:008173c23f95b170204355c12626cb5a965d779a7e1283b09e9cffbb1bf33ca3
COPY bin/ /usr/local/bin/
